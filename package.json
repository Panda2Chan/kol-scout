{
  "name": "kol-scout",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "backend": "node backend/server.js",
    "build:css": "tailwindcss -i ./src/popup/tailwind.css -o ./src/popup/popup.css --minify",
    "package:extension": "npm run build:css && node scripts/package-extension.mjs --target=production",
    "package:extension:dev": "node scripts/package-extension.mjs --target=development",
    "dev:css": "tailwindcss -i ./src/popup/tailwind.css -o ./src/popup/popup.css --watch",
    "test": "node --test",
    "check": "find src backend -name '*.js' -print0 | xargs -0 -n1 node --check && node -e \"JSON.parse(require('fs').readFileSync('manifest.json','utf8')); console.log('manifest ok')\""
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "redis": "^4.7.1"
  }
}
