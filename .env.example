# Runtime
APP_ENV=development
HOST=127.0.0.1
PORT=8787
CORS_ORIGINS=*
PUBLIC_BASE_URL=

# Extension release build
KOL_API_BASE_URL=http://127.0.0.1:8787
KOL_API_AUTH_TOKEN=

# Public access controls
AUTH_REQUIRED=false
API_AUTH_TOKEN=
API_AUTH_TOKENS=
ACCESS_LIMITS_ENABLED=false
IP_RATE_LIMIT_WINDOW_MS=60000
IP_RATE_LIMIT_MAX_REQUESTS=60
USER_DAILY_DISCOVERY_QUOTA=0
USER_CONCURRENT_DISCOVERY_LIMIT=0

# Discovery queue
DISCOVERY_QUEUE_LIMITS_ENABLED=false
DISCOVERY_MAX_CONCURRENT=0
DISCOVERY_QUEUE_MAX_SIZE=0
DISCOVERY_QUEUE_TIMEOUT_MS=30000

# Usage and cache
USAGE_SINK=jsonl
USAGE_JSONL_PATH=logs/usage.jsonl
CACHE_DRIVER=memory
REDIS_URL=
AI_PLAN_CACHE_TTL_MS=600000

# 可选 AI 配置：支持 DeepSeek、OpenAI 及 OpenAI 兼容中转平台
# 留空时跟随同一系统用户 ~/.cc-switch 下当前 Codex 供应商和模型
# 显式提供 Key 或地址时，只使用环境连接凭据，并须同时提供环境模型
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# chat / responses；沿用 cc-switch 连接时留空读取 wire_api，缺省 chat
AI_API_MODE=
# 供应商不支持内置 web_search 时设为 true，仍可进行 AI 规划/复核与平台召回
AI_WEB_SEARCH_DISABLED=false

# 兼容别名：通用 AI_* 优先；模型无内置默认值，无模型名称白名单
# Key 还支持 AI_OPENAI_API_KEY，地址还支持 AI_OPENAI_BASE_URL
# 模型优先级：AI_MODEL > OPENAI_MODEL > AI_SEARCH_MODEL > cc-switch 当前模型
# API 模式别名：AI_SEARCH_API_MODE
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# DeepSeek 示例：AI_BASE_URL=https://api.deepseek.com，AI_MODEL=deepseek-flash
# Command Code 示例：AI_BASE_URL=https://api.commandcode.ai/provider/v1
# 模型 ID 均应以供应商/中转平台实际支持为准，详见 README

# Optional third-party KOL data source
KOL_DATA_API_URL=
KOL_DATA_API_KEY=

# Optional TikTok multi-search aggregation sources
TAVILY_API_KEY=
JINA_API_KEY=
JINA_QUOTA_PROBE_ENABLED=true
JINA_QUOTA_PROBE_TIMEOUT_MS=5000
JINA_QUOTA_PROBE_QUERY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=

# Timeout overrides
AI_SEARCH_TIMEOUT_MS=60000
DISCOVERY_TOTAL_TIMEOUT_MS=300000
